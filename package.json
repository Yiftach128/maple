{
  "name": "maple",
  "version": "0.0.0",
  "private": true,
  "description": "Human-to-agent visual UX comments on deployed preview environments",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maple-kit/maple.git"
  },
  "homepage": "https://github.com/maple-kit/maple",
  "bugs": "https://github.com/maple-kit/maple/issues",
  "scripts": {
    "attw": "pnpm -r --filter \"./packages/*\" exec attw --pack . --profile esm-only",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "demo:record": "node tools/demo-recorder/record.ts && tools/demo-recorder/encode.sh",
    "examples:verify": "pnpm build && pnpm -r --filter \"./examples/*\" verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks": "lefthook install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:suppress": "eslint . --suppress-all",
    "publint": "pnpm -r --filter \"./packages/*\" exec publint",
    "release": "pnpm build && pnpm changeset publish",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @maple-kit/core build && pnpm -r --filter \"./examples/*\" typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-maple": "workspace:*",
    "eslint-plugin-perfectionist": "5.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "lefthook": "2.1.14",
    "msw": "2.15.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "vitest-browser-react": "2.3.0"
  }
}
