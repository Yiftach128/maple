{
  "name": "@maple-kit/ui",
  "version": "0.12.0",
  "description": "Maple's composed reviewer parts: the marks, the island and the composer",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maple-kit/maple.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/maple-kit/maple/tree/main/packages/ui",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./composer": "./dist/composer/index.js",
    "./icons": "./dist/icons/index.js",
    "./island": "./dist/island/index.js",
    "./maple": "./dist/maple.js",
    "./marks": "./dist/marks/index.js",
    "./mock": "./dist/mock/index.js",
    "./notice": "./dist/notice/index.js",
    "./picker": "./dist/picker/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node ./scripts/size.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "size": "node ./scripts/size.js"
  },
  "dependencies": {
    "@maple-kit/core": "workspace:*",
    "@maple-kit/mock": "workspace:*",
    "@maple-kit/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
