# Copy to .env.local and fill in. .env* is gitignored except this file.
# Values are injected in development with `op run --env-file=.env.example --`,
# so what lives here are references, never secrets.
#
# `docs/configuration.md` says which of these are secrets and why.

# The comment App. `.claude/skills/setup-maple-org` registers one. Device Flow
# needs the client id and nothing else: no secret, no private key.
MAPLE_GITHUB_CLIENT_ID=
# Optional. 32 random bytes; encrypts the reviewer's cookie at rest.
MAPLE_COOKIE_KEY=

# The gate App, and a second App on purpose — docs/github-auth.md says why.
# Only needed for a resolve that clears the check with no new push; the gate
# in CI runs on the workflow's own GITHUB_TOKEN.
MAPLE_GATE_APP_ID=
MAPLE_GATE_INSTALLATION_ID=
MAPLE_GATE_PRIVATE_KEY=

# The assist tier. Absent, nothing is scored and the composer is unchanged.
TYPESAFE_API_KEY=
MAPLE_AI_MODEL=
MAPLE_AI_API=

# Branch or pull request the Vite example's overlay attributes comments to.
# VITE_-prefixed because only those names reach client code.
VITE_MAPLE_BRANCH=

# The MCP server and its Stop hook, on a developer's machine or in CI; never
# in a preview. GITHUB_TOKEN is an agent's token, not a reviewer's.
GITHUB_TOKEN=
MAPLE_GITHUB_OWNER=
MAPLE_GITHUB_REPO=
MAPLE_GITHUB_API=
MAPLE_STORE=
# The branch under review. Read by the Stop hook, not by the overlay.
MAPLE_BRANCH=
# The deployed route's mount URL; a resolve asks it to republish the gate.
MAPLE_URL=
# CI only, never beside MAPLE_URL: a gate App installation token, good for an hour.
MAPLE_GATE_TOKEN=
MAPLE_REQUIRE_APPROVAL=

# Turns the JSX tagger on. Preview builds only; never set in production.
MAPLE_PREVIEW=0
