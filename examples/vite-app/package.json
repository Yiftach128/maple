{
  "name": "@maple-kit/example-vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "predev": "pnpm --filter @maple-kit/core build && pnpm --filter @maple-kit/classifier build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "node scripts/verify.ts"
  },
  "dependencies": {
    "@launchdarkly/js-client-sdk": "4.10.2",
    "@maple-kit/classifier": "workspace:*",
    "@maple-kit/core": "workspace:*",
    "@maple-kit/mock": "workspace:*",
    "@maple-kit/react": "workspace:*",
    "@maple-kit/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0"
  }
}
